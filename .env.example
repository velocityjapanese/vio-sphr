# Copy to .env for local runs (never commit .env).
# In GitHub Actions these names are provided as repository secrets instead.

# YouTube OAuth (refresh-token flow, Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional aliases used by some setups
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Optional: rename the channel without touching code
CHANNEL_NAME=ViolinSpheric

# Text generation for titles / descriptions / tags
POLLINATIONS_API_KEY=

# Optional Facebook Page mirror
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
